# ==============================================================================
# Akhand Bharat Seva - Translation API Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to `.env` and fill in your actual credentials.
# 2. Never commit your `.env` file containing real API keys to version control.
# 3. For production, keep API secret keys on a secure backend proxy server.
# ==============================================================================

# Translation Provider Name:
# Options: bhashini | google | azure | libretranslate | custom
TRANSLATION_API_PROVIDER=bhashini

# Translation API Key / Secret Token:
TRANSLATION_API_KEY=your_translation_api_key_here

# Translation API Endpoint URL:
# For Bhashini (Government of India): https://nmt-api.ai4bharat.org/translate_v2 or https://api.bhashini.gov.in/v1/translate
# For Google Cloud Translation: https://translation.googleapis.com/language/translate/v2
# For Azure Cognitive Translator: https://api.cognitive.microsofttranslator.com/translate?api-version=3.0
TRANSLATION_API_ENDPOINT=https://api.bhashini.gov.in/v1/translate

# Provider specific metadata (e.g. for Bhashini ULCA / AI4Bharat):
TRANSLATION_USER_ID=your_bhashini_user_id
TRANSLATION_PIPELINE_ID=your_bhashini_pipeline_id
TRANSLATION_SOURCE_LANGUAGE=en

# Secure Server-Side Proxy Endpoint (Optional / Recommended):
# Set this if you use a backend proxy to keep your API key secret from browser clients.
TRANSLATION_BACKEND_PROXY_URL=http://localhost:3000/api/translate
